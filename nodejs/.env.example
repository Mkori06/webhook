# Smart QR Access - Webhook Receiver Configuration (Node.js)

# Port to listen on
PORT=3000

# Client's API Secret configured in Smart QR Access platform (used for HMAC-SHA256 signature verification)
# Leave empty to skip signature verification during initial testing
SMARTQR_API_SECRET=my_smartqr_test_secret_123

# Bearer token configured in Smart QR Developer Portal (optional)
# Leave empty if no Bearer token was specified in the portal
SMARTQR_WEBHOOK_BEARER=test_bearer_token_xyz

# Maximum allowable timestamp drift in seconds (replay attack protection, default: 300 seconds)
TIMESTAMP_TOLERANCE_SECONDS=300
